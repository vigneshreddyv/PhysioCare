# Isolated staging template. Copy into the approved secret/configuration system;
# do not commit a populated runtime environment file.
ENVIRONMENT=staging
STAGING_INSTANCE_ID=physiocare-isolated-staging
HOST=127.0.0.1
PORT=8000
# Use a dedicated staging credential and a trusted CA. TLS verification must remain enabled.
MONGODB_URL=mongodb://STAGING_USER:STAGING_PASSWORD@staging-db.example.invalid:27017/physiocare_staging?authSource=admin&tls=true
DATABASE_NAME=physiocare_staging
STAGING_DATABASE_HOST=staging-db.example.invalid
STAGING_DATABASE_NAME=physiocare_staging
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["https://staging.example.invalid"]
CLINIC_TIMEZONE=Asia/Kolkata
BOOKING_HORIZON_DAYS=30

AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REGISTRATION_LIMIT=5
AUTH_REGISTRATION_WINDOW_SECONDS=3600
AUTH_REFRESH_IP_LIMIT=120
AUTH_REFRESH_LIMIT=30
AUTH_REFRESH_WINDOW_SECONDS=60
# Replace with the exact ingress proxy CIDRs. An empty list is rejected.
TRUSTED_PROXY_NETWORKS=[]

LAB_DEMO_MODE=false
HOME_VISIT_DEMO_MODE=false
STAGING_STORAGE_ROOT=/var/lib/physiocare-staging
LAB_REPORT_STORAGE_DIR=/var/lib/physiocare-staging/lab-reports
LAB_REPORT_QUARANTINE_DIR=/var/lib/physiocare-staging/lab-report-quarantine
LAB_REPORT_MAX_BYTES=5242880
CLINICAL_REPORT_STORAGE_DIR=/var/lib/physiocare-staging/clinical-reports
CLINICAL_REPORT_QUARANTINE_DIR=/var/lib/physiocare-staging/clinical-report-quarantine
CLINICAL_REPORT_MAX_BYTES=5242880
PDF_SCAN_TIMEOUT_SECONDS=30
# Uploads remain fail-closed until a private clamd service and its operational
# review are approved. Then set clamav_unix and an absolute private socket path.
PDF_SCANNER_MODE=disabled
PDF_SCANNER_SOCKET=

# Keep payments disabled until a separately authorized Razorpay Test Mode run.
RAZORPAY_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
APPOINTMENT_BILLING_CURRENCY=
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=30
PAYMENT_RECONCILIATION_BATCH_SIZE=50
PAYMENT_RECONCILIATION_LEASE_SECONDS=120
