# MongoDB Configuration
# Ordinary local development only. Use a separate loopback MongoDB instance;
# never point this template at an existing or remote database.
MONGODB_URL=mongodb://127.0.0.1:27017/physiocare_dev
DATABASE_NAME=physiocare_dev

# Security Configuration
# Set two different high-entropy values of at least 32 characters before startup.
# Deliberately left blank so copying this file cannot start with known JWT secrets.
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Shared Mongo-backed authentication throttling. Forwarded client addresses are
# ignored unless the direct proxy is listed here as an IP/CIDR.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REGISTRATION_LIMIT=5
AUTH_REGISTRATION_WINDOW_SECONDS=3600
AUTH_REFRESH_IP_LIMIT=120
AUTH_REFRESH_LIMIT=30
AUTH_REFRESH_WINDOW_SECONDS=60
TRUSTED_PROXY_NETWORKS=[]

# Server Configuration
ENVIRONMENT=development
# Keep this identity set in local configuration so an accidental environment
# override cannot make this local workspace start as staging or production.
PHYSIOCARE_LOCAL_DEV=true
PORT=8000
HOST=127.0.0.1
CLINIC_TIMEZONE=Asia/Kolkata
# New bookings may use today plus the following 29 clinic-calendar days.
BOOKING_HORIZON_DAYS=30
# Configurable demonstration schedule only; not verified clinic or doctor hours.
DEMO_SCHEDULE_START=09:00
DEMO_SCHEDULE_END=18:00
DEMO_SLOT_MINUTES=30
DEMO_HOME_VISIT_REQUESTS_ENABLED=true
# Provisional, configurable service boundary. Address still requires clinic verification.
DEMO_HOME_SERVICE_CITY=Nellore
# Separate demonstration home-visit availability. These are not verified clinic,
# clinician, travel-buffer, or operating-hour settings and must be configured before launch.
DEMO_HOME_SCHEDULE_START=09:00
DEMO_HOME_SCHEDULE_END=18:00
DEMO_HOME_SLOT_MINUTES=30
LAB_REPORT_STORAGE_DIR=uploads/lab-reports
LAB_REPORT_QUARANTINE_DIR=uploads/lab-report-quarantine
LAB_REPORT_MAX_BYTES=5242880
CLINICAL_REPORT_STORAGE_DIR=uploads/clinical-reports
CLINICAL_REPORT_QUARANTINE_DIR=uploads/clinical-report-quarantine
CLINICAL_REPORT_MAX_BYTES=5242880
PDF_SCAN_TIMEOUT_SECONDS=30
PDF_SCANNER_MODE=disabled
PDF_SCANNER_SOCKET=
# Payments remain disabled until separately approved.
RAZORPAY_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RECONCILIATION_ENABLED=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
