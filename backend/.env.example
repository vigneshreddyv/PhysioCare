# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=physiocare

# Security Configuration
JWT_SECRET=supersecretjwtsecretkeyshouldbechangedinproduction123!
JWT_REFRESH_SECRET=supersecretjwtrefreshsecretkeyshouldbechangedinproduction123!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Phase 4 Task 20 — application logging
# Root-logger level for the centralized logging configuration. INFO is
# the baseline that makes the reconciliation observability lines visible.
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL (an absent or unrecognized
# value falls back to INFO — never DEBUG, never a crash).
LOG_LEVEL=INFO

# Razorpay Configuration (payment gateway - backend only)
# Get keys from https://dashboard.razorpay.com/#/app/keys
# RAZORPAY_KEY_SECRET must NEVER be exposed to the frontend, API responses, or logs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Reserved for webhook signature verification (later phase)
RAZORPAY_WEBHOOK_SECRET=
# Timeout in seconds applied to Razorpay API requests
RAZORPAY_TIMEOUT_SECONDS=30

# Phase 4 Task 9 — stale pending-payment reconciliation
# NO expiry duration is approved by default: automatic expiry is OFF and
# no default duration is chosen by the implementation. To activate (only
# after the product owner defines the policy), set BOTH values, e.g.:
#   PAYMENT_PENDING_EXPIRY_MINUTES=<approved duration>
#   PAYMENT_RECONCILIATION_ENABLED=true
# While disabled, no pending-payment booking is ever expired automatically.
# Expiry is always Razorpay-checked first (fail-closed) once activated.
PAYMENT_PENDING_EXPIRY_MINUTES=
PAYMENT_RECONCILIATION_ENABLED=false

# Phase 4 Task 16 — refund reconciliation & recovery
# Master switch for the refund reconciliation background loop. Default OFF:
# no automatic reconciliation policy is approved. When enabled, refunds
# stuck in `processing` are reconciled against Razorpay's authoritative
# Refunds API — by persisted refund identity when one exists, otherwise by
# the payment's own refund list — and only a proven `processed` refund is
# completed (validate → persist identity → atomic completion). Fail-closed:
# timeout / 5xx / malformed / mismatched responses keep the refund
# `processing`; nothing is ever re-refunded automatically.
REFUND_RECONCILIATION_ENABLED=false
