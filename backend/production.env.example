# Production configuration inventory. This is not a deployable environment file.
# Supply blank targets and secrets through an approved, access-controlled secret
# manager and explicit process environment. Launch with backend/run_production.py;
# backend/run.py is for development and enables reload.
# Never copy a local development .env into a production runtime.
ENVIRONMENT=production
PHYSIOCARE_LOCAL_DEV=false
LAB_DEMO_MODE=false
HOME_VISIT_DEMO_MODE=false
DEMO_HOME_VISIT_REQUESTS_ENABLED=false
HOST=127.0.0.1
PORT=8000

# Dedicated production MongoDB target. The URI must include its exact database,
# credentials, explicit tls=true and verified certificates/hostnames. A standard
# mongodb:// URI also requires an explicit replicaSet option.
MONGODB_URL=
DATABASE_NAME=
PRODUCTION_DATABASE_HOST=
PRODUCTION_DATABASE_NAME=

# Two different high-entropy secrets, at least 32 characters each.
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REGISTRATION_LIMIT=5
AUTH_REGISTRATION_WINDOW_SECONDS=3600
AUTH_REFRESH_IP_LIMIT=120
AUTH_REFRESH_LIMIT=30
AUTH_REFRESH_WINDOW_SECONDS=60
# Replace with the exact trusted ingress proxy CIDRs; [] fails startup.
TRUSTED_PROXY_NETWORKS=[]
# Replace with exact approved HTTPS browser origins; [] fails startup.
CORS_ORIGINS=[]
CLINIC_TIMEZONE=Asia/Kolkata
BOOKING_HORIZON_DAYS=30

# Absolute, distinct private paths below the approved production storage root.
PRODUCTION_STORAGE_ROOT=
LAB_REPORT_STORAGE_DIR=
LAB_REPORT_QUARANTINE_DIR=
LAB_REPORT_MAX_BYTES=5242880
CLINICAL_REPORT_STORAGE_DIR=
CLINICAL_REPORT_QUARANTINE_DIR=
CLINICAL_REPORT_MAX_BYTES=5242880
PDF_SCAN_TIMEOUT_SECONDS=30
PDF_SCANNER_MODE=clamav_unix
# Absolute private Unix socket path; blank fails startup.
PDF_SCANNER_SOCKET=

# Keep provider integration and reconciliation disabled until separately approved.
RAZORPAY_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
APPOINTMENT_BILLING_CURRENCY=
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=30
PAYMENT_RECONCILIATION_BATCH_SIZE=50
PAYMENT_RECONCILIATION_LEASE_SECONDS=120
